# Пример значений; приложение автоматически .env не читает.
QOR_DB_PATH=./data/qor.db
QOR_PG_DSN=postgresql://qor:CHANGE_ME@127.0.0.1:5432/qor_search
# local: модель Qwen2.5-0.5B; api: совместимый HTTPS API
QOR_LLM_BACKEND=local
# Только для режима api (не записывайте настоящий ключ в репозиторий)
QOR_LLM_BASE_URL=
QOR_LLM_API_KEY=
QOR_LLM_MODEL=
QOR_MIN_SIMILARITY=0.80
